# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
# Every variable is prefixed SAGE_ and maps to a field on sage.config.Settings.
#
# The prefix is not optional. A line without it (OPENAI_API_KEY=...) is read
# from this file, matches no field, and is dropped. Settings never sees it and
# neither does the provider SDK.

SAGE_ENVIRONMENT=local
SAGE_DEBUG=true

SAGE_HOST=127.0.0.1
SAGE_PORT=8000

SAGE_LOG_LEVEL=INFO
SAGE_LOG_JSON=false

# --- LLM ---------------------------------------------------------------------
# Which adapter runs. "echo" replies locally with no key and no network, so the
# app boots with none of the settings below. Switch to "langchain" to go live.
SAGE_LLM_BACKEND=echo

# "<provider>:<model>". Changing the prefix changes provider, and nothing else
# moves. Install that provider's package first:
#   uv add langchain-anthropic  ->  SAGE_LLM_MODEL=anthropic:claude-haiku-4-5-20251001
#   uv add langchain-google-genai -> SAGE_LLM_MODEL=google_genai:gemini-2.0-flash
SAGE_LLM_MODEL=openai:gpt-4o-mini
SAGE_LLM_TEMPERATURE=0.0

# Your key. Works for whichever provider SAGE_LLM_MODEL names, so it does not
# get renamed when you switch.
# Leave it unset and the provider SDK falls back to its own variable
# (OPENAI_API_KEY, ANTHROPIC_API_KEY) read from the real environment — not
# from this file. That fallback is the usual choice for CI and production.
SAGE_LLM_API_KEY=sk-replace-me

# Optional. Any OpenAI-compatible server: Ollama, vLLM, OpenRouter, a proxy.
# SAGE_LLM_BASE_URL=http://localhost:11434/v1
#
# Running in Docker changes what "localhost" means: inside a container it is
# the container, not your machine. A provider running on the host needs
# host.docker.internal instead. docker-compose.yml already sets OLLAMA_HOST
# that way, so Ollama works with no change here — but any other host-run
# provider needs the line above, pointed at host.docker.internal.

# --- Retrieval ----------------------------------------------------------------
# Off by default: with no index built, the app boots and answers from the model
# alone. Turned on, it refuses to start until `uv run poe index` has been run
# with these same settings — a stale index is a failure that answers wrongly in
# silence, so it is made loud at startup instead.
SAGE_RETRIEVAL=false

SAGE_CORPUS_PATH=data/pebble

# "hashing" is offline, free, and deterministic — the `echo` of embeddings. It
# matches on shared words and has no semantics at all, so it is a test double
# rather than a small model. Switch to "langchain" for the real thing.
SAGE_EMBEDDING_BACKEND=hashing

# "<provider>:<model>", same convention as SAGE_LLM_MODEL, and it reuses
# SAGE_LLM_API_KEY and SAGE_LLM_BASE_URL.
#
# Careful with the E5, BGE and Nomic families: they expect "query:" and
# "passage:" prefixes that LangChain's generic wrapper does not add, and
# without them retrieval quietly degrades with no error anywhere. They need a
# sibling adapter, not this one.
SAGE_EMBEDDING_MODEL=openai:text-embedding-3-small

# "bruteforce" is exact — one matrix multiply, no index to build, and faster
# than any graph at this corpus size. It is also the oracle `poe bench`
# measures the approximate store against. "qdrant" is HNSW.
SAGE_VECTOR_STORE=bruteforce
SAGE_INDEX_PATH=data/index

SAGE_RETRIEVAL_TOP_K=5

# ":memory:" or a path runs Qdrant in-process with no server, which is how the
# test suite reaches it. An http(s) URL is a real server.
#
# Note this is a *host-side* value, and `poe index` and `poe bench` both run on
# the host. Inside compose the API reaches the service as http://qdrant:6333,
# which compose sets for the container itself.
#
# You do not need to reconcile the two to run the stack: compose has an
# `indexer` service that builds the index with the API's own environment before
# the API starts. This only matters if you want to index or benchmark the
# compose Qdrant from your machine, in which case it wants localhost:
#   SAGE_QDRANT_URL=http://localhost:6333
SAGE_QDRANT_URL=:memory:
SAGE_QDRANT_COLLECTION=pebble

# Kilobytes of vector data below which Qdrant skips its HNSW graph and scans
# exhaustively — which for 82 chunks is both faster and exact, and is what the
# 10 MB default does here. Set to 0 to force the graph on. Left unset, so
# turning approximation on stays a decision somebody made rather than an
# assumption. `poe bench` is what says when it starts to pay.
# SAGE_QDRANT_FULL_SCAN_THRESHOLD=0
